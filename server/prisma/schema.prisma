generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id    String @id @default(cuid())
  title String

  userId String
  user   User   @relation(fields: [userId], references: [id])
  tags   Tag[]

  columns Column[]
}

model Column {
  id       String @id @default(cuid())
  title    String
  position Int

  boardId String
  board   Board  @relation(fields: [boardId], references: [id])

  cards Card[]
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  position Int

  columnId String
  column   Column @relation(fields: [columnId], references: [id])
  tags     Tag[]
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  boards Board[]
}

model Tag {
  id      String @id @default(cuid())
  name    String
  color   String
  boardId String
  board   Board  @relation(fields: [boardId], references: [id])
  cards   Card[]
}
